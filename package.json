{
  "name": "pnpm-monorepo-electron-prisma",
  "displayName": "myApp",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "common": "pnpm --filter @app/common",
    "desktop": "pnpm --filter @app/desktop",
    "app": "pnpm --filter electron-app",
    "dev": "pnpm build:pkgs && pnpm desktop dev",
    "build:pkgs": "pnpm common build",
    "build:win": "pnpm build:pkgs && pnpm desktop build:win",
    "init:db": "pnpm common db:generate && pnpm common db:migrate",
    "prepare": "husky",
    "commitlint": "commitlint --config commitlint.config.js",
    "postinstall": "node ./scripts/install.js && pnpm init:db"
  },
  "lint-staged": {
    "apps/desktop/**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts,vue}": "pnpm --filter @app/desktop exec eslint --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^20.17.17",
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0"
  }
}
