/**
 * AnalyticsEvent model wrapper (v8 ORM API)
 */
export const getAnalyticsEventModel = (client, db) => ({
  modelName: 'AnalyticsEvent',

  create: async function (data = {}) {
    if (!data.type) return { event: null, error: 'type is required' }
    if (!data.timestamp) return { event: null, error: 'timestamp is required' }

    try {
      // v8: application supplies id
      const event = await client.AnalyticsEvent.create({
        id: crypto.randomUUID(),
        type: data.type,
        timestamp: data.timestamp,
        data: data.data || null,
      })

      return { event, error: null }
    } catch (error) {
      console.error('AnalyticsEvent create failed:', error.message)
      return { event: null, error: error.message }
    }
  },

  get: async function (clause = {}) {
    try {
      const event = await client.AnalyticsEvent.where(clause).first()
      return event || null
    } catch (error) {
      console.error('AnalyticsEvent get failed:', error.message)
      return null
    }
  },

  where: async function (clause = {}, limit = null, orderBy = null) {
    try {
      let query = client.AnalyticsEvent.where(clause)

      if (orderBy) {
        // Convert v7-style to v8 callback
        const [key, direction] = Object.entries(orderBy)[0]
        query = query.orderBy((a) => a[key][direction]())
      }

      if (limit !== null) {
        query = query.limit(limit)
      }

      return await query.all()
    } catch (error) {
      console.error('AnalyticsEvent where failed:', error.message)
      return []
    }
  },

  delete: async function (clause = {}) {
    try {
      await client.AnalyticsEvent.where(clause).delete()
      return true
    } catch (error) {
      console.error('AnalyticsEvent delete failed:', error.message)
      return false
    }
  },
})

export default { getAnalyticsEventModel }
