import { datetimeColumn, textColumn } from '@prisma/orm-sqlite/adapter/column-types'
import { defineContract, field, model } from '@prisma/orm-sqlite/contract-builder'

/**
 * MULTI-DATABASE EXAMPLE - Analytics Database
 *
 * This is a minimal second database demonstrating Prisma v8 multi-database patterns.
 * Purpose: Generic event logging / analytics (could represent logs, cache, feature-specific data).
 *
 * Pattern demonstrated:
 * - Separate contract file (this file)
 * - Separate CLI config (prisma.analytics.config.ts)
 * - Separate generated client (generated/analytics_db_client/)
 * - Separate runtime factory (utils/prisma/analyticsRuntime.js)
 * - Separate migrations directory (prisma/analytics/migrations/)
 * - Separate npm scripts (db:generate:analytics, db:migrate:analytics)
 *
 * To add a 3rd database (e.g., cache, logs):
 * 1. Copy src/prisma/analytics/ → src/prisma/<name>/
 * 2. Copy prisma.analytics.config.ts → prisma.<name>.config.ts
 * 3. Copy src/utils/prisma/analyticsRuntime.js → src/utils/prisma/<name>Runtime.js
 * 4. Copy src/models/Analytics*.js → src/models/<Name>*.js
 * 5. Add scripts to package.json (db:generate:<name>, db:migrate:<name>)
 * 6. Export from facade.js and types.d.ts
 * 7. Wire Electron IPC handler in apps/desktop/src/main/
 *
 * To remove this example:
 * - Delete src/prisma/analytics/
 * - Delete prisma.analytics.config.ts
 * - Delete src/utils/prisma/analyticsRuntime.js
 * - Delete src/models/Analytics*.js
 * - Remove analytics scripts from package.json
 * - Remove analytics exports from facade.js and types.d.ts
 * - Delete apps/desktop/src/main/utils/analyticsDb.ts
 * - Remove analytics IPC handler from apps/desktop/src/main/index.ts
 * - Remove analytics API from apps/desktop/src/preload/index.ts
 */

const AnalyticsEvent = model('AnalyticsEvent', {
  fields: {
    id: field.column(textColumn).id().default('uuid()'),
    type: field.column(textColumn), // e.g., "app_launch", "feature_used"
    timestamp: field.column(datetimeColumn),
    data: field.column(textColumn).optional(), // JSON blob
  },
})

const AnalyticsMeta = model('AnalyticsMeta', {
  fields: {
    key: field.column(textColumn).id(),
    value: field.column(textColumn),
  },
})

export const contract = defineContract({
  models: {
    AnalyticsEvent,
    AnalyticsMeta,
  },
})
