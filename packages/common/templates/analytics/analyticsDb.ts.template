import fs from 'node:fs'
import path from 'node:path'
// getAnalyticsPrisma + runAnalyticsPrismaCommand are exported from the facade,
// so they are bundled into @app/common/dist/index.js by esbuild. Each DB has its
// own migration runner because the shared runPrismaCommand statically imports the
// main contract.
import * as commonFacade from '@app/common'

const { getAnalyticsPrisma, runAnalyticsPrismaCommand } = commonFacade as unknown as {
  getAnalyticsPrisma: (ctx: unknown) => Promise<Record<string, any>>
  runAnalyticsPrismaCommand: (param: { ctx: unknown }) => Promise<number>
}
import { dbContext } from './dbContext'

const ANALYTICS_DB_FILE_NAME = 'analyticsDb.db'

let resolveAnalyticsReady: () => void
const analyticsReady = new Promise<void>((resolve) => {
  resolveAnalyticsReady = resolve
})

let analyticsPrismaPromise: ReturnType<typeof getAnalyticsPrisma> | null = null

/**
 * Initialize analytics database
 * - Creates DB file if missing
 * - Runs pending migrations
 * - Caches Prisma client promise
 */
export async function initAnalyticsDB() {
  try {
    const dbPath = dbContext.getAnalyticsDBPath()
    const dbExists = fs.existsSync(dbPath)

    if (!dbExists) {
      console.log('Analytics DB not found, creating:', dbPath)
      const dir = path.dirname(dbPath)
      if (!fs.existsSync(dir)) {
        fs.mkdirSync(dir, { recursive: true })
      }
      fs.closeSync(fs.openSync(dbPath, 'w'))
    }

    // Run migrations (idempotent via v8 ControlClient)
    console.log('Running analytics DB migrations...')
    await runAnalyticsPrismaCommand({
      ctx: dbContext,
    })

    // Initialize client
    analyticsPrismaPromise = getAnalyticsPrisma(dbContext)
    await analyticsPrismaPromise

    console.log('✓ Analytics DB ready')
    resolveAnalyticsReady()
  } catch (error) {
    console.error('Analytics DB initialization failed:', error)
    resolveAnalyticsReady() // Resolve anyway to avoid blocking
  }
}

/**
 * IPC handler for analytics persistence actions
 * Mirrors handlePersistenceAction pattern from db.ts
 */
export async function handleAnalyticsAction(
  _,
  model: string,
  action: string,
  ...args: unknown[]
) {
  await analyticsReady

  if (!analyticsPrismaPromise) {
    throw new Error('Analytics DB not initialized')
  }

  const prisma = await analyticsPrismaPromise
  const modelWrapper = prisma[model]

  if (!modelWrapper) {
    throw new Error(`Analytics model ${model} not found`)
  }

  if (typeof modelWrapper[action] !== 'function') {
    throw new Error(`Action ${action} not found on analytics model ${model}`)
  }

  return modelWrapper[action](...args)
}
